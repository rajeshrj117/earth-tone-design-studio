rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // =========================================================
    // ETDS FILE STORAGE
    // =========================================================
    //
    // All file operations are performed through trusted
    // Next.js server routes using Firebase Admin SDK.
    //
    // Browser users cannot directly upload, modify or delete
    // project files.
    //

    match /projects/{projectId}/{kind}/{fileName} {
      allow read, write: if false;
    }

    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if false;
    }

    // =========================================================
    // EXPLICIT DENY FOR EVERYTHING ELSE
    // =========================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}